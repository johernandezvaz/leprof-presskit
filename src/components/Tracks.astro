---
/** Selected works (§7.7): sección 03, superficie dark-lifted. */
import SectionHeader from './ui/SectionHeader.astro';
import Chip from './ui/Chip.astro';
import Icon from './ui/icons/Icon.astro';
import { t } from '../lib/i18n';
import { works, type WorkType } from '../data/works';

const typeKeys: Record<WorkType, string> = {
  Release: 'works.type.release',
  'Unofficial Remix': 'works.type.unofficialRemix',
  Mix: 'works.type.mix',
};
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="works" class="relative scroll-mt-24 bg-dark-lifted px-6 py-24 md:px-10 md:py-32 lg:px-16 lg:py-40">
  <div class="mx-auto max-w-6xl">
    <SectionHeader index={3} eyebrowKey="works.eyebrow" titleKey="works.title" />

    <ul data-reveal-stagger>
      {
        works.map((work, i) => (
          <li>
            <a
              href={work.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group -mx-4 grid grid-cols-[3ch_1fr_auto] items-center gap-4 rounded-3xl border-b border-line px-4 py-6 transition-colors duration-150 hover:bg-accent/[0.04] focus-visible:bg-accent/[0.04] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent md:grid-cols-[4ch_1fr_auto_auto] md:gap-8 md:rounded-full"
            >
              <span class="text-meta tabular-nums text-off-white-muted transition-colors duration-150 group-hover:text-accent">
                {pad(i + 1)}
              </span>
              <div>
                <h3 class="block text-balance font-display text-title text-off-white transition-colors duration-150 group-hover:text-accent">
                  {work.title}
                </h3>
                <span class="mt-2 block text-meta tabular-nums text-off-white-muted">
                  {work.year} · <span data-key={typeKeys[work.type]}>{t('en', typeKeys[work.type])}</span>
                  <span class="md:hidden">· {work.label}</span>
                </span>
                <span class="sr-only">
                  (<span data-key="works.opensNewTab">{t('en', 'works.opensNewTab')}</span>)
                </span>
              </div>
              <span class="hidden md:inline-flex">
                <Chip>{work.label}</Chip>
              </span>
              <span
                class="grid size-11 place-items-center rounded-full border border-line-strong text-off-white transition-colors duration-150 group-hover:border-accent group-hover:bg-accent group-hover:text-dark"
                aria-hidden="true"
              >
                <Icon name="arrow-up-right" size={18} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

---
/** About / Statement (§7.6): sección 02. */
import SectionHeader from './ui/SectionHeader.astro';
import Portrait from './ui/Portrait.astro';
import { splitLead, t } from '../lib/i18n';
import { galleryImages } from '../data/gallery';

const [lead, rest] = splitLead(t('en', 'about.bio'));
---

<section id="statement" class="relative scroll-mt-24 overflow-hidden px-6 py-24 md:px-10 md:py-32 lg:px-16 lg:py-40">
  <div class="mx-auto max-w-6xl">
    <SectionHeader index={2} eyebrowKey="about.eyebrow" titleKey="about.title" />

    <div class="grid grid-cols-12 items-start gap-6 md:gap-8">
      <div class="col-span-12 mb-16 flex justify-center md:col-span-4 md:mb-0 md:mt-16 md:justify-start" data-reveal>
        <Portrait
          src={galleryImages[2]}
          altKey="about.portraitAlt"
          sizes="(min-width: 1024px) 280px, 220px"
          satellite={{ href: '#contact', icon: 'arrow-right', labelKey: 'about.contactAria' }}
          class="size-[220px] lg:size-[280px]"
        />
      </div>

      <div class="col-span-12 md:col-span-8" data-reveal>
        <p class="text-pretty font-sans text-display-m font-light" data-key-lead="about.bio">
          <span class="text-off-white" data-lead>{lead}</span><span class="text-off-white-soft" data-rest>{` ${rest}`}</span>
        </p>
        <p class="mt-12 max-w-[60ch] text-pretty text-body-l text-off-white-soft" data-key="about.mission">
          {t('en', 'about.mission')}

          
        </p>
      </div>
    </div>
  </div>
</section>

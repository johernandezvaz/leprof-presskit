---
/** Footer (§7.12). */
import IconButton from './ui/IconButton.astro';
import { t } from '../lib/i18n';

const year = new Date().getFullYear();
---

<footer class="border-t border-line px-6 py-12 md:px-10 lg:px-16">
  <div class="mx-auto max-w-6xl">
    <div class="flex items-center justify-between gap-6">
      <p class="font-display text-title text-off-white">Le Prof</p>
      <IconButton href="#hero" icon="arrow-up" label={t('en', 'footer.backToTop')} labelKey="footer.backToTop" />
    </div>
    <p class="mt-8 text-eyebrow uppercase text-off-white-muted">
      © {year} <span data-key="contact.footer">{t('en', 'contact.footer')}</span>
    </p>
  </div>
</footer>

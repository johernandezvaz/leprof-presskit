---
/** Navegación flotante (§7.3), toggle de idioma (§7.4) y menú móvil. */
import Button from './ui/Button.astro';
import IconButton from './ui/IconButton.astro';
import { t } from '../lib/i18n';

const links = [
  { href: '#statement', key: 'nav.about' },
  { href: '#works', key: 'nav.works' },
  { href: '#venues', key: 'nav.venues' },
  { href: '#gallery', key: 'nav.gallery' },
  { href: '#contact', key: 'nav.contact' },
];

// Menú móvil: las 6 secciones numeradas como en §4.5.
const mobileLinks = [{ href: '#hero', key: 'nav.home' }, ...links];
const pad = (n: number) => String(n).padStart(2, '0');

const ringTight = 'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-0';
---

<div class="fixed inset-x-4 top-4 z-40">
  <nav
    id="nav-pill"
    aria-label={t('en', 'nav.primary')}
    data-key-aria="nav.primary"
    class="mx-auto flex h-14 max-w-6xl items-center justify-between rounded-full border border-line bg-dark/70 pl-6 pr-2 shadow-[0_8px_32px_rgba(0,0,0,0.45)] backdrop-blur-xl transition-colors duration-300"
  >
    <a href="#hero" class:list={['rounded-full font-display text-[17px] font-semibold tracking-tight text-off-white', ringTight]}>
      Le Prof
    </a>

    <ul class="hidden items-center gap-8 lg:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'nav-link group relative -mx-2 inline-flex h-11 items-center rounded-full px-2 font-sans text-ui text-off-white-soft transition-colors duration-150 hover:text-off-white aria-[current=true]:text-off-white',
                ringTight,
              ]}
            >
              <span data-key={link.key}>{t('en', link.key)}</span>
              <span
                class="absolute bottom-1 left-1/2 size-1 -translate-x-1/2 rounded-full bg-accent opacity-0 transition-opacity duration-150 group-aria-[current=true]:opacity-100"
                aria-hidden="true"
              />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <div
        class="flex rounded-full border border-line bg-dark/50 p-1"
        role="group"
        aria-label={t('en', 'nav.language')}
        data-key-aria="nav.language"
      >
        {
          ['en', 'es'].map((lang) => (
            <button
              type="button"
              class:list={[
                'lang-btn relative h-8 rounded-full px-3 font-sans text-[12px] font-medium uppercase tracking-[0.1em] text-off-white-muted transition-colors duration-150 after:absolute after:-inset-y-1.5 after:inset-x-0 hover:text-off-white aria-pressed:bg-accent aria-pressed:text-dark',
                ringTight,
              ]}
              data-lang={lang}
              lang={lang}
              aria-label={lang === 'en' ? 'English' : 'Español'}
              aria-pressed={lang === 'en' ? 'true' : 'false'}
            >
              {lang}
            </button>
          ))
        }
      </div>

      <Button href="#contact" size="sm" class="hidden lg:inline-flex">
        <span data-key="nav.booking">{t('en', 'nav.booking')}</span>
      </Button>

      <IconButton
        id="menu-open"
        icon="menu"
        iconSize={24}
        label={t('en', 'nav.openMenu')}
        labelKey="nav.openMenu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="lg:hidden"
      />
    </div>
  </nav>
</div>

<div
  id="mobile-menu"
  class="pointer-events-none fixed inset-0 z-50 flex flex-col bg-dark px-6 pb-10 pt-4 opacity-0 transition-opacity duration-300 ease-out-expo data-[open]:pointer-events-auto data-[open]:opacity-100 lg:hidden"
  inert
>
  <div class="flex h-14 items-center justify-between pl-6 pr-2">
    <span class="font-display text-[17px] font-semibold tracking-tight text-off-white">Le Prof</span>
    <IconButton id="menu-close" icon="close" iconSize={24} label={t('en', 'nav.closeMenu')} labelKey="nav.closeMenu" />
  </div>

  <ul
    id="mobile-menu-list"
    class="mt-12 flex translate-y-6 flex-col gap-6 px-2 transition-transform duration-300 ease-out-expo"
  >
    {
      mobileLinks.map((link, i) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'nav-link flex items-baseline gap-4 rounded-3xl font-display text-display-l text-off-white transition-colors duration-150 hover:text-accent',
              ringTight,
            ]}
          >
            <span class="text-eyebrow tabular-nums text-accent" aria-hidden="true">
              {pad(i + 1)}
            </span>
            <span data-key={link.key}>{t('en', link.key)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { getCurrentLanguage, setLanguage } from '../lib/i18n';
  import type { Language } from '../lib/i18n';

  // Toggle de idioma: aria-pressed marca el activo.
  const langButtons = document.querySelectorAll<HTMLButtonElement>('.lang-btn');
  function syncLangButtons(lang: Language) {
    langButtons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn.dataset.lang === lang)));
  }
  langButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.lang as Language;
      if (lang !== getCurrentLanguage()) setLanguage(lang);
    });
  });
  window.addEventListener('languagechange', ((e: CustomEvent) => syncLangButtons(e.detail.language)) as EventListener);
  syncLangButtons(getCurrentLanguage());

  // Píldora más opaca tras 24px de scroll.
  const pill = document.getElementById('nav-pill')!;
  const onScroll = () => {
    const scrolled = window.scrollY > 24;
    pill.classList.toggle('bg-dark/85', scrolled);
    pill.classList.toggle('bg-dark/70', !scrolled);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Sección activa (aria-current + punto dorado).
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
  const sections = document.querySelectorAll<HTMLElement>('main section[id]');
  const setActive = (id: string) => {
    navLinks.forEach((link) => {
      if (link.getAttribute('href') === `#${id}`) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  };
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive(entry.target.id);
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
  }

  // Menú móvil.
  const menu = document.getElementById('mobile-menu')!;
  const list = document.getElementById('mobile-menu-list')!;
  const openBtn = document.getElementById('menu-open')!;
  const closeBtn = document.getElementById('menu-close')!;

  function openMenu() {
    menu.setAttribute('data-open', '');
    menu.inert = false;
    list.classList.replace('translate-y-6', 'translate-y-0');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.classList.add('overflow-hidden');
    closeBtn.focus();
  }

  function closeMenu(returnFocus = true) {
    menu.removeAttribute('data-open');
    menu.inert = true;
    list.classList.replace('translate-y-0', 'translate-y-6');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('overflow-hidden');
    if (returnFocus) openBtn.focus();
  }

  openBtn.addEventListener('click', openMenu);
  closeBtn.addEventListener('click', () => closeMenu());
  menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.hasAttribute('data-open')) closeMenu();
  });
</script>

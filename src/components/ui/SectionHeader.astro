---
/**
 * Cabecera de sección (§6.4, §4.3): eyebrow con punto dorado + numeración + h2 display-l.
 * Textos por clave de i18n; el HTML estático sale del diccionario EN.
 * Slot opcional "intro": va en col-span-4 col-start-9, alineado abajo.
 */
import { t } from '../../lib/i18n';

interface Props {
  index: number;
  total?: number;
  eyebrowKey: string;
  titleKey: string;
  id?: string;
}

const { index, total = 6, eyebrowKey, titleKey, id } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const hasIntro = Astro.slots.has('intro');
---

<header class="mb-16 grid grid-cols-12 gap-6 md:mb-24 md:gap-8" data-reveal>
  <div class="col-span-12 mb-6 flex items-center justify-between">
    <p class="flex items-center gap-3 text-eyebrow uppercase text-off-white-muted">
      <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
      <span data-key={eyebrowKey}>{t('en', eyebrowKey)}</span>
    </p>
    <span class="text-eyebrow tabular-nums text-off-white-muted" aria-hidden="true">{pad(index)} / {pad(total)}</span>
  </div>
  <h2 id={id} class="col-span-12 text-balance font-display text-display-l text-off-white lg:col-span-7" data-key={titleKey}>
    {t('en', titleKey)}
  </h2>
  {
    hasIntro && (
      <div class="col-span-12 self-end text-pretty text-body-l text-off-white-soft lg:col-span-4 lg:col-start-9">
        <slot name="intro" />
      </div>
    )
  }
</header>

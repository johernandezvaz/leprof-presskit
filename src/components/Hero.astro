---
/** Hero (§7.5): sección 01. Retrato con surcos, halo dorado y marca de agua. */
import Button from './ui/Button.astro';
import Portrait from './ui/Portrait.astro';
import Watermark from './ui/Watermark.astro';
import { t } from '../lib/i18n';
import { HERO_PORTRAIT } from '../lib/site';
import { works } from '../data/works';
import { venues } from '../data/venues';

const pad = (n: number) => String(n).padStart(2, '0');
// Datos derivados del contenido existente (§7.5: solo si el contenido existe).
const stats = [
  { value: works.length, key: 'hero.stats.works' },
  { value: venues.length, key: 'hero.stats.venues' },
  { value: venues.reduce((sum, v) => sum + v.appearances.length, 0), key: 'hero.stats.shows' },
];
---

<section
  id="hero"
  class="relative isolate flex min-h-[100svh] scroll-mt-24 items-center overflow-hidden px-6 pb-24 pt-32 md:px-10 md:pb-32 lg:px-16"
>
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_70%_40%,rgba(198,167,94,0.10),transparent_60%)]"
    aria-hidden="true"
  >
  </div>
  <Watermark textKey="hero.watermark" class="bottom-0 translate-y-1/4" />

  <div class="mx-auto grid w-full max-w-6xl grid-cols-12 items-center gap-6 md:gap-8">
    <div class="col-span-12 lg:col-span-7">
      <p class="mb-6 flex flex-wrap items-center gap-3 text-eyebrow uppercase text-off-white-muted" data-reveal>
        <span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        <span data-key="hero.role">{t('en', 'hero.role')}</span>
        <span aria-hidden="true">·</span>
        <span data-key="hero.location">{t('en', 'hero.location')}</span>
      </p>

      <h1 class="font-display text-display-xl text-off-white" data-reveal-lines>
        <span class="block overflow-hidden pb-[0.06em]"><span data-line>Le</span></span>
        <span class="block overflow-hidden pb-[0.06em]"><span data-line>Prof</span></span>
      </h1>

      <div data-reveal>
        <p class="mt-8 max-w-[60ch] text-pretty text-body-l text-off-white-soft" data-key="hero.tagline">
          {t('en', 'hero.tagline')}
        </p>

        <div class="mt-12 flex flex-wrap gap-3">
          <Button href="#contact" variant="primary">
            <span data-key="hero.booking">{t('en', 'hero.booking')}</span>
          </Button>
          <Button href="#works" variant="secondary">
            <span data-key="hero.listen">{t('en', 'hero.listen')}</span>
          </Button>
        </div>

        <dl class="mt-16 grid max-w-md grid-cols-3 gap-6 md:gap-8">
          {
            stats.map((stat) => (
              <div class="flex flex-col-reverse gap-2">
                <dt class="text-eyebrow uppercase text-off-white-muted" data-key={stat.key}>
                  {t('en', stat.key)}
                </dt>
                <dd class="font-display text-display-l tabular-nums text-off-white">{pad(stat.value)}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <div class="order-first col-span-12 my-16 flex justify-center lg:order-none lg:col-span-5 lg:my-0 lg:justify-end" data-reveal>
      <Portrait
        src={HERO_PORTRAIT}
        altKey="hero.portraitAlt"
        sizes="(min-width: 1280px) 400px, (min-width: 1024px) 340px, 220px"
        priority
        satellite={{ href: '#works', icon: 'play', labelKey: 'hero.listenAria' }}
        class="size-[220px] lg:size-[340px] xl:size-[400px]"
      />
    </div>
  </div>
</section>

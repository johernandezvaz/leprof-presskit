---
/** Gallery (§7.9): sección 05. Bento de 12 columnas, spans 7/5 y 4/8. */
import SectionHeader from './ui/SectionHeader.astro';
import { t } from '../lib/i18n';
import { cld, srcset } from '../lib/cloudinary';
import { galleryImages } from '../data/gallery';

// Spans y proporciones del bento. En md+ la celda "aspect-auto" toma la altura de su fila.
const tiles = [
  { span: 'md:col-span-7', aspect: 'aspect-[16/10]', sizes: '(min-width: 768px) 58vw, 100vw' },
  { span: 'md:col-span-5', aspect: 'aspect-square md:aspect-auto', sizes: '(min-width: 768px) 42vw, 100vw' },
  { span: 'md:col-span-4', aspect: 'aspect-[4/5]', sizes: '(min-width: 768px) 33vw, 100vw' },
  { span: 'md:col-span-8', aspect: 'aspect-[16/10] md:aspect-auto', sizes: '(min-width: 768px) 67vw, 100vw' },
];
---

<section id="gallery" class="relative scroll-mt-24 px-6 py-24 md:px-10 md:py-32 lg:px-16 lg:py-40">
  <div class="mx-auto max-w-6xl">
    <SectionHeader index={5} eyebrowKey="gallery.eyebrow" titleKey="gallery.title" />

    <div class="grid grid-cols-12 gap-6 md:gap-8" data-reveal-stagger>
      {
        galleryImages.map((src, i) => (
          <figure class:list={['group relative isolate col-span-12 overflow-hidden rounded-3xl', tiles[i].span, tiles[i].aspect]}>
            <img
              src={cld(src, 1024)}
              srcset={srcset(src)}
              sizes={tiles[i].sizes}
              alt={t('en', 'gallery.altPerformance')}
              data-key-alt="gallery.altPerformance"
              class="absolute inset-0 size-full object-cover transition-transform duration-[900ms] ease-out-expo group-hover:scale-[1.04]"
              data-zoom
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))
      }
    </div>
  </div>
</section>

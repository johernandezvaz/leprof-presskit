---
/** Contact (§7.11): sección 06. Panel estadio con marca de agua "BOOKING". */
import SectionHeader from './ui/SectionHeader.astro';
import Button from './ui/Button.astro';
import Watermark from './ui/Watermark.astro';
import Icon from './ui/icons/Icon.astro';
import { t, getTranslations } from '../lib/i18n';
import { EMAIL } from '../lib/site';

const en = getTranslations('en');
const inquiryHref = `mailto:${EMAIL}?subject=${encodeURIComponent(en.contact.emailSubject)}&body=${encodeURIComponent(en.contact.emailBody)}`;
---

<section id="contact" class="relative scroll-mt-24 px-6 py-24 md:px-10 md:py-32 lg:px-16 lg:py-40">
  <div class="mx-auto max-w-6xl">
    <div class="relative isolate overflow-hidden rounded-[40px] border border-line bg-dark-lifted px-6 py-16 md:px-16 md:py-24">
      <Watermark textKey="contact.watermark" class="bottom-0 translate-y-1/4" />

      <SectionHeader index={6} eyebrowKey="contact.eyebrow" titleKey="contact.title" />

      <div data-reveal>
        <a
          href={`mailto:${EMAIL}`}
          class="inline break-all bg-[linear-gradient(currentColor,currentColor)] bg-[length:0%_1px] bg-left-bottom bg-no-repeat font-sans text-display-m font-light text-off-white transition-[background-size,color] duration-300 hover:bg-[length:100%_1px] hover:text-accent focus-visible:bg-[length:100%_1px]"
        >
          {EMAIL}
        </a>

        <div class="mt-12 flex flex-wrap gap-3">
          <Button id="inquiry-link" href={inquiryHref} variant="primary">
            <span data-key="contact.sendInquiry">{t('en', 'contact.sendInquiry')}</span>
          </Button>
          <Button id="copy-email" variant="secondary" data-email={EMAIL}>
            <span data-copy-icon><Icon name="copy" size={18} /></span>
            <span data-copied-icon class="hidden"><Icon name="check" size={18} /></span>
            <span data-copy-label data-key="contact.copyEmail">{t('en', 'contact.copyEmail')}</span>
          </Button>
        </div>
        <p class="sr-only" role="status" aria-live="polite" id="copy-status"></p>
      </div>
    </div>
  </div>
</section>

<script>
  import { getCurrentLanguage, getTranslations } from '../lib/i18n';
  import type { Language } from '../lib/i18n';
  import { EMAIL } from '../lib/site';

  const inquiry = document.getElementById('inquiry-link');
  function updateInquiry(lang: Language) {
    const t = getTranslations(lang);
    inquiry?.setAttribute(
      'href',
      `mailto:${EMAIL}?subject=${encodeURIComponent(t.contact.emailSubject)}&body=${encodeURIComponent(t.contact.emailBody)}`,
    );
  }
  window.addEventListener('languagechange', ((e: CustomEvent) => updateInquiry(e.detail.language)) as EventListener);
  updateInquiry(getCurrentLanguage());

  // Copiar email → "Copiado ✓" durante 2s.
  const copyBtn = document.getElementById('copy-email') as HTMLButtonElement | null;
  const label = copyBtn?.querySelector<HTMLElement>('[data-copy-label]');
  const copyIcon = copyBtn?.querySelector<HTMLElement>('[data-copy-icon]');
  const copiedIcon = copyBtn?.querySelector<HTMLElement>('[data-copied-icon]');
  const status = document.getElementById('copy-status');
  let timer: number | undefined;

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(EMAIL);
    } catch {
      return;
    }
    const t = getTranslations(getCurrentLanguage());
    if (label) {
      label.dataset.key = 'contact.copied';
      label.textContent = t.contact.copied;
    }
    copyIcon?.classList.add('hidden');
    copiedIcon?.classList.remove('hidden');
    if (status) status.textContent = t.contact.copied;
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      const current = getTranslations(getCurrentLanguage());
      if (label) {
        label.dataset.key = 'contact.copyEmail';
        label.textContent = current.contact.copyEmail;
      }
      copyIcon?.classList.remove('hidden');
      copiedIcon?.classList.add('hidden');
      if (status) status.textContent = '';
    }, 2000);
  });
</script>
